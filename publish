#!/bin/sh
# publish — compile paper + poster + slides, copy PDFs to repo root, commit, and push
set -eu

REPO="/home/gc/Documents/quantum-spin-public"
cd "$REPO"

# Compile paper (pdflatex) → out/paper.pdf
echo "=== Compiling paper ==="
cd "$REPO/paper"
latexmk -g -pdf paper.tex
cp "out/paper.pdf" "../gordon-chan-quantum-spin.pdf"

# Compile poster (lualatex) → out/poster.pdf
echo "=== Compiling poster ==="
cd "$REPO/poster"
latexmk -g -lualatex poster.tex

# Compile slides (pdflatex) → out/slides.pdf
echo "=== Compiling slides ==="
cd "$REPO/slides"
latexmk -g -pdf slides.tex

# Commit and push
cd "$REPO"
git add -A
if git diff --cached --quiet; then
    echo "Nothing to publish."
else
    git commit -m "Update paper, poster, and slides"
    git pull --rebase
    git push
    echo "=== Published → github.com/ganddoffcha/quantum-spin ==="
fi
