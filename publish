#!/bin/sh
# publish — compile paper + poster + slides, commit, and push to github.com/ganddoffcha/quantum-spin
set -eu

REPO="/home/gc/Documents/quantum-spin-public"

cd "$REPO"

# Compile paper (pdflatex)
echo "=== Compiling paper ==="
cd "$REPO/paper"
latexmk -g -pdf paper.tex

# Compile poster (lualatex)
echo "=== Compiling poster ==="
cd "$REPO/poster"
latexmk -g -lualatex poster.tex

# Compile slides (pdflatex)
echo "=== Compiling slides ==="
cd "$REPO/slides"
latexmk -g -pdf slides.tex

# Commit and push
cd "$REPO"
git add -A
if git diff --cached --quiet; then
    echo "Nothing to publish."
else
    git commit -m "Update paper, poster, and slides"
    git pull --rebase
    git push
    echo "=== Published → github.com/ganddoffcha/quantum-spin ==="
fi
